{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "streamlit_app/Pagina_principal_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f streamlit_app/requirements.txt ] && pip3 install --user -r streamlit_app/requirements.txt; pip3 install --user pytest; echo 'Packages installed'",
  "postAttachCommand": {
    "server": "streamlit run streamlit_app/Pagina_principal_app.py --server.port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
